pipeline {
    agent any

    triggers {
        // Run ~1 hour after the source backup job (which runs at ~02:xx)
        cron('H 3 * * *')
    }

    environment {
        LC_SOURCE_HOST      = credentials('lc-source-host')
        LC_BACKUP_HTTP_USER = credentials('lc-backup-http-user')
        LC_BACKUP_HTTP_PASS = credentials('lc-backup-http-pass')
        LC_BACKUP_HTTP_PATH = '/backups/localcosmos/'
        LC_LOCAL_BACKUP_DIR = '/var/backups/localcosmos'
        // Keep more sets on the backup machine than on the source
        LC_RETENTION_DAYS   = '14'
        LC_NOTIFY_EMAIL     = credentials('lc-notify-email')
    }

    stages {
        stage('Pull Backup') {
            steps {
                sh './backup/pull-backup.sh'
            }
        }
    }

    post {
        failure {
            mail to: "${env.LC_NOTIFY_EMAIL}",
                 subject: "LocalCosmos pull-backup FAILED on ${env.BUILD_URL}",
                 body: "Check the Jenkins build log: ${env.BUILD_URL}"
        }
    }
}
